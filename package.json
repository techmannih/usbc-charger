{
  "name": "usb-c-pd-20w-charger",
  "version": "1.0.0",
  "private": true,
  "description": "12 V DC to USB-C Power Delivery 18 W source board in tscircuit",
  "main": "index.circuit.tsx",
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "snapshot:3d": "tsci snapshot --3d --camera-preset top-center-angled",
    "snapshot:3d:update": "tsci snapshot --3d --update --camera-preset top-center-angled",
    "typecheck": "tsc --noEmit",
    "start": "tsci dev"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "tscircuit": "^0.0.2297",
    "typescript": "^5.9.3"
  }
}
